@startuml

frame "Christian" #LightBlue {

    object "<u>Christian Hauschke:Person</u>" as personChristian #ffffff {
       personName = {
       \t firstNames = "Christian"
       \t familyNames = "Hauschke"
       } ^^ PersonName
    }

    object "<u>Christian ORCID:ORCID_Identifier</u>" as orcidChristian #ffffff {
       orcidId = "https://orcid.org/0000-0003-2499-7741" ^^ ORCID_iD_Type
    }

    personChristian o--> "has-identifier" orcidChristian

    object "<u>TIB:Organisation_Unit</u>" as institutionTIB #ffffff {
        name = "Leibniz Information Centre for Science and Technology and University Library"@en,
        \t "Leibniz-Informationszentrum Technik und Naturwissenschaften und Universitätsbibliothek"@de
        acronym = "TIB"
        contacts = [
        \t\t\t{uri =  "https://www.tib.eu/en/" ^^ URI}
        \t\t] ^^ List<Contact_Information>
    }

    object "<u>TIB ROR:ROR_Identifier</u>" as rorTIB #ffffff {
        rorId = "https://ror.org/04aj4c181" ^^ ROR_ID_Type
    }

    institutionTIB o--> "has-identifier" rorTIB

    object "<u>TIB Affiliation:Affiliation_Statement</u>" as affiliationChristianTIB #ffffff {
        displayAffiliation = "TIB -
        \t Leibniz Information Centre for Science and Technology and University Library"@en
        displayPersonName = "Hauschke, Christian"
    }

    affiliationChristianTIB o--> "has-institution" institutionTIB

    object "<u>Christian's presentation at ZBMed:Contribution_to_Event</u>" as contributionChristianZBMedMarch2025 #ffffff {
        dateRange = {
        \t startDate = 2025-03-25 ^^ Date
        } ^^ DateRange
    }

    personChristian o--> "is-actor-in" contributionChristianZBMedMarch2025

    contributionChristianZBMedMarch2025 o--> "has-affiliation-statement" affiliationChristianTIB

    object "<u>Christian's Contribution Statement:Contribution_Statement</u>" as contributionStatementChristianZBMedMarch2025 #ffffff {
        statement = "Christian presented VIVO as an ontology, as well as main features of the VIVO platform. His speech generated 7 sections in the complete session."@en
    }

    contributionChristianZBMedMarch2025 o--> "has-contribution-statement" contributionStatementChristianZBMedMarch2025

    object "<u>Christian's slides for ZBMed presentation:Authorship</u>" as contributionChristianSlides #ffffff {
        contributionSequenceKey = 1
        dateRange = {
        \t startDate = 2025 ^^ Date
        \t endDate = 2025-03-25 ^^ Date
        } ^^ DateRange
    }

    personChristian o--> "is-actor-in" contributionChristianSlides

    contributionChristianSlides o--> "has-affiliation-statement" affiliationChristianTIB

    object "<u>Christian's Slides Contribution Statement:CRediT_Contribution_Statement</u>" as contributionStatementChristianSlides #ddeedd {
        roleType = "Writing – original draft" ^^ CRediT_Role_Type
        degreeOfContribution = "Lead" ^^ CRediT_Degree_of_Contribution
        statement = "Christian produces the first 34 slides."@en
    }

    contributionChristianSlides o--> "has-contribution-statement" contributionStatementChristianSlides

}


