    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Object Properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- https://w3id.org/cerif2/spm/Scholarly_Publication#hasAccessRightsSpecification -->


    <owl:ObjectProperty rdf:about="https://w3id.org/cerif2/spm/Scholarly_Publication#hasAccessRightsSpecification">
        <rdfs:domain rdf:resource="https://w3id.org/cerif2/spm/Scholarly_Publication"/>
        <rdfs:range rdf:resource="https://w3id.org/cerif2/spm/Scholarly_Publication"/>
        <rdfs:comment xml:lang="en">A Scholarly Publication has an optional *access rights specification*: an instance of [Scholarly Publication Accessibility Specification](../entities/Scholarly_Publication_Accessibility_Specification.md).</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/cerif2/spm/Scholarly_Publication#hasAuthorship -->


    <owl:ObjectProperty rdf:about="https://w3id.org/cerif2/spm/Scholarly_Publication#hasAuthorship">
        <rdfs:domain rdf:resource="https://w3id.org/cerif2/spm/Scholarly_Publication"/>
        <rdfs:range rdf:resource="https://w3id.org/cerif2/spm/Authorship"/>
        <rdfs:comment xml:lang="en">A Scholarly Publication can have any number of [Authorships](../entities/Authorship.md). This relationship is derived from [Document.has-contribution](https://github.com/EuroCRIS/CERIF-Core/blob/main/entities/Document.md#user-content-rel__has-contribution) by including just those [Contributions to Documents](https://github.com/EuroCRIS/CERIF-Core/blob/main/entities/Contribution_to_Document.md) that are [Authorships](../entities/Authorship.md).</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Data properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- https://w3id.org/cerif2/spm/CRediT_Contribution_Statement#degreeOfContribution -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/cerif2/spm/CRediT_Contribution_Statement#degreeOfContribution">
        <rdfs:domain rdf:resource="https://w3id.org/cerif2/spm/CRediT_Contribution_Statement"/>
        <rdfs:range rdf:resource="https://w3id.org/cerif2/spm/CRediT_Degree_of_Contribution"/>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/cerif2/spm/CRediT_Contribution_Statement#roleType -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/cerif2/spm/CRediT_Contribution_Statement#roleType">
        <rdfs:domain rdf:resource="https://w3id.org/cerif2/spm/CRediT_Contribution_Statement"/>
        <rdfs:range rdf:resource="https://w3id.org/cerif2/spm/CRediT_Role_Type"/>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/cerif2/spm/Editorship#leadingEditorFlag -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/cerif2/spm/Editorship#leadingEditorFlag">
        <rdfs:domain rdf:resource="https://w3id.org/cerif2/spm/Editorship"/>
        <rdfs:range rdf:resource="https://w3id.org/cerif2/Boolean"/>
        <rdfs:label>indicates whether this editor contributed all or major effort (true)</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/cerif2/spm/Embargoed_Access_COAR_Accessibility_Specification_v_1_0#embargoEndDate -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/cerif2/spm/Embargoed_Access_COAR_Accessibility_Specification_v_1_0#embargoEndDate">
        <rdfs:domain rdf:resource="https://w3id.org/cerif2/spm/Embargoed_Access_COAR_Accessibility_Specification_v_1_0"/>
        <rdfs:range rdf:resource="https://w3id.org/cerif2/Date"/>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/cerif2/spm/Journal#acronym -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/cerif2/spm/Journal#acronym">
        <rdfs:domain rdf:resource="https://w3id.org/cerif2/spm/Journal"/>
        <rdfs:range rdf:resource="https://w3id.org/cerif2/Multilingual_String"/>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/cerif2/spm/Journal#endDate -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/cerif2/spm/Journal#endDate">
        <rdfs:domain rdf:resource="https://w3id.org/cerif2/spm/Journal"/>
        <rdfs:range rdf:resource="https://w3id.org/cerif2/Date"/>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/cerif2/spm/Journal#startDate -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/cerif2/spm/Journal#startDate">
        <rdfs:domain rdf:resource="https://w3id.org/cerif2/spm/Journal"/>
        <rdfs:range rdf:resource="https://w3id.org/cerif2/Date"/>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/cerif2/spm/Journal#title -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/cerif2/spm/Journal#title">
        <rdfs:domain rdf:resource="https://w3id.org/cerif2/spm/Journal"/>
        <rdfs:range rdf:resource="https://w3id.org/cerif2/Multilingual_String"/>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/cerif2/spm/Journal_Article#endPage -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/cerif2/spm/Journal_Article#endPage">
        <rdfs:domain rdf:resource="https://w3id.org/cerif2/spm/Journal_Article"/>
        <rdfs:range rdf:resource="https://w3id.org/cerif2/String"/>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/cerif2/spm/Journal_Article#number -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/cerif2/spm/Journal_Article#number">
        <rdfs:domain rdf:resource="https://w3id.org/cerif2/spm/Journal_Article"/>
        <rdfs:range rdf:resource="https://w3id.org/cerif2/String"/>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/cerif2/spm/Journal_Article#startPage -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/cerif2/spm/Journal_Article#startPage">
        <rdfs:domain rdf:resource="https://w3id.org/cerif2/spm/Journal_Article"/>
        <rdfs:range rdf:resource="https://w3id.org/cerif2/String"/>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/cerif2/spm/Journal_Article#volume -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/cerif2/spm/Journal_Article#volume">
        <rdfs:domain rdf:resource="https://w3id.org/cerif2/spm/Journal_Article"/>
        <rdfs:range rdf:resource="https://w3id.org/cerif2/String"/>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/cerif2/spm/Monograph#eISBN -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/cerif2/spm/Monograph#eISBN">
        <rdfs:domain rdf:resource="https://w3id.org/cerif2/spm/Monograph"/>
        <rdfs:range rdf:resource="https://w3id.org/cerif2/spm/ISBN"/>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/cerif2/spm/Monograph#isbn -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/cerif2/spm/Monograph#isbn">
        <rdfs:domain rdf:resource="https://w3id.org/cerif2/spm/Monograph"/>
        <rdfs:range rdf:resource="https://w3id.org/cerif2/spm/ISBN"/>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/cerif2/spm/Publication_Series#eISSN -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/cerif2/spm/Publication_Series#eISSN">
        <rdfs:domain rdf:resource="https://w3id.org/cerif2/spm/Publication_Series"/>
        <rdfs:range rdf:resource="https://w3id.org/cerif2/spm/ISSN"/>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/cerif2/spm/Publication_Series#issn -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/cerif2/spm/Publication_Series#issn">
        <rdfs:domain rdf:resource="https://w3id.org/cerif2/spm/Publication_Series"/>
        <rdfs:range rdf:resource="https://w3id.org/cerif2/spm/ISSN"/>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/cerif2/spm/Publishership#leadingPublisherFlag -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/cerif2/spm/Publishership#leadingPublisherFlag">
        <rdfs:domain rdf:resource="https://w3id.org/cerif2/spm/Publishership"/>
        <rdfs:range rdf:resource="https://w3id.org/cerif2/Boolean"/>
        <rdfs:label>indicates whether this publisher was the leading one among several (true)</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Classes
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- https://w3id.org/cerif2/spm/Authorship -->


    <owl:Class rdf:about="https://w3id.org/cerif2/spm/Authorship">
        <rdfs:subClassOf rdf:resource="https://w3id.org/cerif2/spm/Contribution_to_Document"/>
        <rdfs:comment xml:lang="en">Structured information about linking an [Agent](https://github.com/EuroCRIS/CERIF-Core/blob/main/entities/Agent.md) or any of its specializations ([Person](https://github.com/EuroCRIS/CERIF-Core/blob/main/entities/Person.md), [Organisation Unit](https://github.com/EuroCRIS/CERIF-Core/blob/main/entities/Organisation_Unit.md)) with a [Document](https://github.com/EuroCRIS/CERIF-Core/blob/main/entities/Document.md) or any of its specializations. Authorship implies responsibility and accountability of an Agent for published Document.</rdfs:comment>
        <rdfs:label xml:lang="en">Authorship</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/cerif2/spm/COAR_Accessibility_Specification_v_1_0 -->


    <owl:Class rdf:about="https://w3id.org/cerif2/spm/COAR_Accessibility_Specification_v_1_0">
        <rdfs:subClassOf rdf:resource="https://w3id.org/cerif2/spm/Scholarly_Publication_Accessibility_Specification"/>
        <rdfs:comment xml:lang="en">The COAR Access Rights vocabulary defines concepts to declare the access status of a resource. Multilingual labels regard regional distinctions in language and term. The Access Rights vocabulary builds on access rights defined in info:eu-repo/semantics. &lt;sup&gt;[1](#fn1)&lt;/sup&gt;</rdfs:comment>
        <rdfs:label xml:lang="en">COAR Accessibility Specification v1.0</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/cerif2/spm/CRediT_Contribution_Statement -->


    <owl:Class rdf:about="https://w3id.org/cerif2/spm/CRediT_Contribution_Statement">
        <rdfs:subClassOf rdf:resource="https://w3id.org/cerif2/spm/Contribution_Statement"/>
        <rdfs:comment xml:lang="en">A statement describing a contribution of an agent in producing a document in accordance with the CRediT contribution role taxonomy.</rdfs:comment>
        <rdfs:label xml:lang="en">CRediTContributionStatement</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/cerif2/spm/Conference_Paper -->


    <owl:Class rdf:about="https://w3id.org/cerif2/spm/Conference_Paper">
        <rdfs:comment xml:lang="en">A paper, published within a conference proceeding, typically the realization of a research paper reporting original research findings.&lt;sup&gt;[1](#fn1)&lt;/sup&gt;</rdfs:comment>
        <rdfs:label xml:lang="en">Conference Paper</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/cerif2/spm/Contribution -->


    <owl:Class rdf:about="https://w3id.org/cerif2/spm/Contribution"/>
    


    <!-- https://w3id.org/cerif2/spm/Contribution_Statement -->


    <owl:Class rdf:about="https://w3id.org/cerif2/spm/Contribution_Statement"/>
    


    <!-- https://w3id.org/cerif2/spm/Contribution_to_Document -->


    <owl:Class rdf:about="https://w3id.org/cerif2/spm/Contribution_to_Document"/>
    


    <!-- https://w3id.org/cerif2/spm/Contribution_to_Evaluation_Outcome -->


    <owl:Class rdf:about="https://w3id.org/cerif2/spm/Contribution_to_Evaluation_Outcome"/>
    


    <!-- https://w3id.org/cerif2/spm/Document -->


    <owl:Class rdf:about="https://w3id.org/cerif2/spm/Document"/>
    


    <!-- https://w3id.org/cerif2/spm/Editorship -->


    <owl:Class rdf:about="https://w3id.org/cerif2/spm/Editorship">
        <rdfs:subClassOf rdf:resource="https://w3id.org/cerif2/spm/Contribution"/>
        <rdfs:comment xml:lang="en">The relationship of an editor to some specific subclasses of [Document](https://github.com/EuroCRIS/CERIF-Core/blob/main/entities/Document.md).
An **editor** selects and prepares for publication material created and submitted by authors, having oversight of its content, format and presentation.&lt;sup&gt;[1](#fn1)&lt;/sup&gt;</rdfs:comment>
        <rdfs:label xml:lang="en">Editorship</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/cerif2/spm/Embargoed_Access_COAR_Accessibility_Specification_v_1_0 -->


    <owl:Class rdf:about="https://w3id.org/cerif2/spm/Embargoed_Access_COAR_Accessibility_Specification_v_1_0">
        <rdfs:subClassOf rdf:resource="https://w3id.org/cerif2/spm/COAR_Accessibility_Specification_v_1_0"/>
        <rdfs:comment xml:lang="en">Embargoed access refers to a resource that is metadata only access until released for open access on a certain date. Embargoes can be required by publishers and funders policies, or set by the author (e.g such as in the case of theses and dissertations).&lt;sup&gt;[1](#fn1)&lt;/sup&gt;</rdfs:comment>
        <rdfs:label xml:lang="en">Embargoed Access COAR Accessibility Specification v1.0</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/cerif2/spm/Evaluation_Outcome -->


    <owl:Class rdf:about="https://w3id.org/cerif2/spm/Evaluation_Outcome"/>
    


    <!-- https://w3id.org/cerif2/spm/Journal -->


    <owl:Class rdf:about="https://w3id.org/cerif2/spm/Journal">
        <rdfs:subClassOf rdf:resource="https://w3id.org/cerif2/spm/Publication_Series"/>
        <rdfs:comment xml:lang="en">A journal is a serial publication devoted to disseminating original research and current developments on a subject. &lt;sup&gt;[1](#fn1)&lt;/sup&gt;</rdfs:comment>
        <rdfs:label xml:lang="en">Journal</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/cerif2/spm/Journal_Article -->


    <owl:Class rdf:about="https://w3id.org/cerif2/spm/Journal_Article">
        <rdfs:subClassOf rdf:resource="https://w3id.org/cerif2/spm/Scholarly_Publication"/>
        <rdfs:comment xml:lang="en">An article on a particular topic and published in a journal issue. &lt;sup&gt;[1](#fn1)&lt;/sup&gt;</rdfs:comment>
        <rdfs:label xml:lang="en">Journal Article</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/cerif2/spm/Manuscript_Review_Activity -->


    <owl:Class rdf:about="https://w3id.org/cerif2/spm/Manuscript_Review_Activity">
        <rdfs:subClassOf rdf:resource="https://w3id.org/cerif2/spm/Contribution_to_Evaluation_Outcome"/>
        <rdfs:comment xml:lang="en">Reviewing a manuscript before a decision is made on whether it is published.</rdfs:comment>
        <rdfs:label xml:lang="en">Manuscript Review Activity</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/cerif2/spm/Manuscript_Review_Outcome -->


    <owl:Class rdf:about="https://w3id.org/cerif2/spm/Manuscript_Review_Outcome">
        <rdfs:subClassOf rdf:resource="https://w3id.org/cerif2/spm/Evaluation_Outcome"/>
        <rdfs:comment xml:lang="en">The outcome of a manuscript review.</rdfs:comment>
        <rdfs:label xml:lang="en">Manuscript Review Outcome</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/cerif2/spm/Manuscript_Suggestion_to_Not_Publish -->


    <owl:Class rdf:about="https://w3id.org/cerif2/spm/Manuscript_Suggestion_to_Not_Publish">
        <rdfs:subClassOf rdf:resource="https://w3id.org/cerif2/spm/Manuscript_Review_Outcome"/>
        <rdfs:comment xml:lang="en">The manuscript either does not fit the intended publishing channel or has major shortcomings that cannot be repaired.</rdfs:comment>
        <rdfs:label xml:lang="en">Manuscript Suggestion to Not Publish</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/cerif2/spm/Manuscript_Suggestion_to_Publish_As_Is -->


    <owl:Class rdf:about="https://w3id.org/cerif2/spm/Manuscript_Suggestion_to_Publish_As_Is">
        <rdfs:subClassOf rdf:resource="https://w3id.org/cerif2/spm/Manuscript_Review_Outcome"/>
        <rdfs:comment xml:lang="en">The manuscript fits the intended publishing channel, is without shortcomings and can be published in its current form.</rdfs:comment>
        <rdfs:label xml:lang="en">Manuscript Suggestion to Publish As-Is</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/cerif2/spm/Manuscript_Suggestion_to_Publish_with_Revisions -->


    <owl:Class rdf:about="https://w3id.org/cerif2/spm/Manuscript_Suggestion_to_Publish_with_Revisions">
        <rdfs:subClassOf rdf:resource="https://w3id.org/cerif2/spm/Manuscript_Review_Outcome"/>
        <rdfs:comment xml:lang="en">The manuscript fits the intended publishing channel, but has shortcomings. 
If the manuscript is revised, it can be published.</rdfs:comment>
        <rdfs:label xml:lang="en">Manuscript Suggestion to Publish with Revisions</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/cerif2/spm/Metadata_Only_Access_COAR_Accessibility_Specification_v_1_0 -->


    <owl:Class rdf:about="https://w3id.org/cerif2/spm/Metadata_Only_Access_COAR_Accessibility_Specification_v_1_0">
        <rdfs:subClassOf rdf:resource="https://w3id.org/cerif2/spm/COAR_Accessibility_Specification_v_1_0"/>
        <rdfs:comment xml:lang="en">Metadata only access refers to a resource in which access is limited to metadata only. The resource itself is described by the metadata, but neither is directly available through the system or platform nor can be referenced to an open access copy in an external journal or trustworthy archive.&lt;sup&gt;[1](#fn1)&lt;/sup&gt;</rdfs:comment>
        <rdfs:label xml:lang="en">Metadata Only Access COAR Accessibility Specification v1.0</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/cerif2/spm/Monograph -->


    <owl:Class rdf:about="https://w3id.org/cerif2/spm/Monograph">
        <rdfs:subClassOf rdf:resource="https://w3id.org/cerif2/spm/Scholarly_Publication"/>
        <rdfs:comment xml:lang="en">[FIXME] Book is a non-serial publication that is complete in one volume or a designated finite number of volumes. &lt;sup&gt;[1](#fn1)&lt;/sup&gt; 
Monograph is a scholarly book or a treatise on a single subject or a group of related subjects.</rdfs:comment>
        <rdfs:label xml:lang="en">Monograph</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/cerif2/spm/Open_Access_COAR_Accessibility_Specification_v_1_0 -->


    <owl:Class rdf:about="https://w3id.org/cerif2/spm/Open_Access_COAR_Accessibility_Specification_v_1_0">
        <rdfs:subClassOf rdf:resource="https://w3id.org/cerif2/spm/COAR_Accessibility_Specification_v_1_0"/>
        <rdfs:comment xml:lang="en">Open access refers to a resource that is immediately and permanently online, and free for all on the Web, without financial and technical barriers.The resource is either stored in the repository or referenced to an external journal or trustworthy archive.&lt;sup&gt;[1](#fn1)&lt;/sup&gt;</rdfs:comment>
        <rdfs:label xml:lang="en">Open Access COAR Accessibility Specification v1.0</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/cerif2/spm/Publication_Channel -->


    <owl:Class rdf:about="https://w3id.org/cerif2/spm/Publication_Channel"/>
    


    <!-- https://w3id.org/cerif2/spm/Publication_Series -->


    <owl:Class rdf:about="https://w3id.org/cerif2/spm/Publication_Series">
        <rdfs:subClassOf rdf:resource="https://w3id.org/cerif2/spm/Publication_Channel"/>
        <rdfs:comment xml:lang="en">A Publication Series is a publication that is published regularly about a particular subject.</rdfs:comment>
        <rdfs:label xml:lang="en">Publication Series</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/cerif2/spm/Publishership -->


    <owl:Class rdf:about="https://w3id.org/cerif2/spm/Publishership">
        <rdfs:subClassOf rdf:resource="https://w3id.org/cerif2/spm/Authorship"/>
        <rdfs:comment xml:lang="en">The relationship of a publisher to some subclasses of [Document](https://github.com/EuroCRIS/CERIF-Core/blob/main/entities/Document.md).
A **publisher** (a person or an organization) publishes material.&lt;sup&gt;[1](#fn1)&lt;/sup&gt;</rdfs:comment>
        <rdfs:label xml:lang="en">Publishership</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/cerif2/spm/Restricted_Access_COAR_Accessibility_Specification_v_1_0 -->


    <owl:Class rdf:about="https://w3id.org/cerif2/spm/Restricted_Access_COAR_Accessibility_Specification_v_1_0">
        <rdfs:subClassOf rdf:resource="https://w3id.org/cerif2/spm/COAR_Accessibility_Specification_v_1_0"/>
        <rdfs:comment xml:lang="en">Restricted access refers to a resource that is available in a system but with some type of restriction for full open access. This type of access can occur in a number of different situations. Some examples are described below: The user must log-in to the system in order to access the resource The user must send an email to the author or system administrator to access the resource Access to the resource is restricted to a specific community (e.g. limited to a university community).&lt;sup&gt;[1](#fn1)&lt;/sup&gt;</rdfs:comment>
        <rdfs:label xml:lang="en">Restricted Access COAR Accessibility Specification v1.0</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/cerif2/spm/Scholarly_Publication -->


    <owl:Class rdf:about="https://w3id.org/cerif2/spm/Scholarly_Publication">
        <rdfs:subClassOf rdf:resource="https://w3id.org/cerif2/spm/Document"/>
        <rdfs:comment xml:lang="en">A resource consisting primarily of words for reading.&lt;sup&gt;[1](#fn1)&lt;/sup&gt;</rdfs:comment>
        <rdfs:label xml:lang="en">Scholarly Publication</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/cerif2/spm/Scholarly_Publication_Accessibility_Specification -->


    <owl:Class rdf:about="https://w3id.org/cerif2/spm/Scholarly_Publication_Accessibility_Specification">
        <rdfs:comment xml:lang="en">[FIXME] An entity for representing vocabularies for definition of concepts to declare the access status of a resource.</rdfs:comment>
        <rdfs:label xml:lang="en">Scholarly Publication Accessibility Rights</rdfs:label>
    </owl:Class>
</rdf:RDF>



