    <!-- https://w3id.org/cerif2/String -->


    <rdfs:Datatype rdf:about="https://w3id.org/cerif2/String"/>
    


    <!-- https://w3id.org/cerif2/spm/CRediT_Degree_of_Contribution -->


    <rdfs:Datatype rdf:about="https://w3id.org/cerif2/spm/CRediT_Degree_of_Contribution"/>
    


