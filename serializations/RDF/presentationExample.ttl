@prefix : <http://www.example.org/cerif_corecoreandpubmodule#> .
@prefix cerif_core: <https://eurocris.org/cerif-core#> .  # or this should be https://w3id.org/cerif2
@prefix cerif_spm: <https://eurocris.org/cerif-spm#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .

@base <http://www.example.org/cerifandpubmodule> .

<http://www.example.org/cerifandpubmodule> a owl:Ontology ;
    rdfs:label "An example for an online presentation"@en .

#################################################################
### Persons and Affiliations
#################################################################

:christian_hauschke a cerif_core:Person ;
    cerif_core:name [
        a cerif_core:PersonName	;
		cerif_core:firstNames "Christian"^^xsd:string ;
        cerif_core:familyNames "Hauschke"^^xsd:string
    ] ;
    cerif_core:hasIdentifier :orcid_christian .

:orcid_christian a cerif_core:ORCID_Identifier ;
    cerif_core:orcidId "0000-0003-2499-7741"^^xsd:string .

:dragan_ivanovic a cerif_core:Person ;
    cerif_core:name [
        a cerif_core:PersonName	;
		cerif_core:firstNames "Dragan"^^xsd:string ;
        cerif_core:familyNames "Ivanović"^^xsd:string
    ] ;
    cerif_core:hasIdentifier :orcid_dragan .

:orcid_dragan a cerif_core:ORCID_Identifier ;
    cerif_core:orcidId "0000-0002-9942-5521"^^xsd:string .

:tib a cerif_core:Organisation_Unit ;
    cerif_core:name "Leibniz Information Centre for Science and Technology and University Library"@en, "Leibniz-Informationszentrum Technik und Naturwissenschaften und Universitätsbibliothek"@de ;
    cerif_core:acronym "TIB"@en ;
	cerif_core:contacts [
		a cerif_core:Website_Address	;
		cerif_core:uri <https://www.tib.eu/en/>
	] ;
    cerif_core:hasIdentifier :ror_tib .

:ror_tib a cerif_core:ROR_Identifier ;
    cerif_core:rorId "04aj4c181"^^xsd:string .

:lyrasis a cerif_core:Organisation_Unit ;
    cerif_core:name "Lyrasis"@en ;
    cerif_core:contacts [
		a cerif_core:Website_Address	;
		cerif_core:uri <https://lyrasis.org/>
	] ;
    cerif_core:hasIdentifier :ror_lyrasis .

:ror_lyrasis a cerif_core:ROR_Identifier ;
    cerif_core:rorId "026tem613"^^xsd:string .

:affiliation_christian_tib a cerif_core:Affiliation_Statement ;
    cerif_core:displayAffiliation "TIB - Leibniz Information Centre for Science and Technology and University Library"@en  ;
    cerif_core:displayPersonName "Hauschke, C."@en ;
    cerif_core:hasOrganisationUnit :tib .

:affiliation_dragan_lyrasis a cerif_core:Affiliation_Statement ;
    cerif_core:displayAffiliation "Lyrasis"@en  ;
    cerif_core:displayPersonName "Ivanovic, D."@en ;
    cerif_core:hasOrganisationUnit :lyrasis .

#################################################################
### Documents (slides, video) and Events
#################################################################

:open_access a cerif_spm:Open_Access_COAR_Accessibility_Specification_v1.0 .

:zbmed_series a cerif_core:Event_Series ;
    cerif_core:title "ZB Med Research Colloquium"@en ;
    cerif_core:recurrencePeriod "1"^^xsd:integer ;
    cerif_core:recurrenceUnit "month"@en .

:zbmed_march2025 a cerif_core:Event ;
    cerif_core:title "ZB Med Research Colloquium for March 2025"@en ;
    cerif_core:startDate "2025-03-01"^^xsd:date ;
    cerif_core:endDate "2025-03-31"^^xsd:date ;
    cerif_core:isPartOf :zbmed_series .

:presentation_slides a cerif_spm:Presentation	,
							cerif_core:Textual_Contents	,
							cerif_core:Downloadable	,
							cerif_core:Accessible_on_the_Web	;
    cerif_core:title "VIVO – An Ontology-Based Research Information System"@en ;
	cerif_core:downloadURL <https://zenodo.org/records/15773109/files/VIVO%20-%20ZB%20MED%20Research%20Seminar.pdf?download=1> ;
    cerif_core:accessURL <https://zenodo.org/records/15773109> ;
	cerif_spm:hasAccessRightsSpecification :open_access	;
    cerif_core:publicationDate "2025-03-20"^^xsd:date ;
	cerif_core:isPublishedIn :zenodo ;
    cerif_core:hasIdentifier :doi_slides .

:doi_slides a cerif_core:DOI_Identifier ;
    cerif_core:DOI_ID "10.5281/zenodo.15773108"^^xsd:string .

:zenodo a cerif_core:Repository , cerif_core:Publication_Channel ;
    cerif_core:title "Zenodo"@en ;
    cerif_core:url <https://zenodo.org/> .

:presentation_video_complete a cerif_spm:Presentation	,
							cerif_core:Video_Contents	,
							cerif_core:Accessible_on_the_Web	 ;
    cerif_core:title "VIVO – An Ontology-Based Research Information System"@en ;
    cerif_core:publicationDate "2025-03-25"^^xsd:date ;
    cerif_core:duration "PT40M14S"^^xsd:duration ;
    cerif_core:accessURL <https://www.youtube.com/watch?v=64lhd_am9ew> ;
    cerif_spm:hasAccessRightsSpecification :open_access	;
    cerif_core:isPublishedIn :youtube .

:zenodo a cerif_core:Repository , cerif_core:Publication_Channel ;
    cerif_core:title "YouTube"@en ;
    cerif_core:url <https://www.youtube.com/> .

:presentation_video_1 a cerif_spm:Presentation	,
							cerif_core:Video_Contents	,
							cerif_core:Accessible_on_the_Web	 ;
    cerif_core:title "What is VIVO and what are the features?"@en ;
    cerif_core:publicationDate "2025-03-25"^^xsd:date ;
    cerif_core:duration "PT4M15S"^^xsd:duration ;
    cerif_core:accessURL <https://www.youtube.com/watch?v=64lhd_am9ew&t=0s> ;
    cerif_spm:hasAccessRightsSpecification :open_access	.

