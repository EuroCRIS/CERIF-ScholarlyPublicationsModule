#################################################################
### Contributions to Documents and Events
#################################################################

### Christian's presentation at ZBMed (Contribution_to_Event)

:contribution_christian_zbmed_march2025 a cerif_core:Contribution_to_Event ;
    cerif_core:hasStartDate "2025-03-25"^^xsd:date ;
    cerif_core:hasAffiliationStatement :affiliation_christian_tib ;
    cerif_core:hasContributionStatement :contribution_statement_christian_zbmed_march2025 .

:christian_hauschke cerif_core:isActorIn :contribution_christian_zbmed_march2025 .
:zbmed_march2025 cerif_core:hasContribution :contribution_christian_zbmed_march2025 .

:contribution_statement_christian_zbmed_march2025 a cerif_core:Contribution_Statement ;
    cerif_core:statement "Christian presented VIVO as an ontology, as well as main features of the VIVO platform. His speech generated 7 sections in the complete session."@en ;
    cerif_core:provides :presentation_video_1	,
						:presentation_video_2	;
	cerif_core:isDetailedIn :resource_usage_statement_christian_dragan_zbmed_march2025 .

### Dragan's presentation at ZBMed (Contribution_to_Event)

:contribution_dragan_zbmed_march2025 a cerif_core:Contribution_to_Event ;
    cerif_core:hasStartDate "2025-03-25"^^xsd:date ;
    cerif_core:hasAffiliationStatement :affiliation_dragan_lyrasis ;
    cerif_core:hasContributionStatement :contribution_statement_dragan_zbmed_march2025 .

:dragan_ivanovic cerif_core:isActorIn :contribution_dragan_zbmed_march2025 .
:zbmed_march2025 cerif_core:hasContribution :contribution_dragan_zbmed_march2025 .

:contribution_statement_dragan_zbmed_march2025 a cerif_core:Contribution_Statement ;
    cerif_core:statement "Dragan presented VIVO technical community and basic process in the code contribution. His speech generated 1 section (the last one) in the complete session."@en ;
    cerif_core:provides :presentation_video_8	;
	cerif_core:isDetailedIn :resource_usage_statement_christian_dragan_zbmed_march2025 .

:resource_usage_statement_christian_dragan_zbmed_march2025 a cerif_core:Resource_Usage_Statement ;
    cerif_core:statement "Material for Christian and Dragan talk is prepared as open-access slides."@en ;
	cerif_core:uses :presentation_slides .

### Contribution to ZBMed March 2025 presentation (slides)

:presentation_slides cerif_core:hasContribution :contribution_christian_presentation,
													:contribution_dragan_presentation .

### Contribution to ZBMed March 2025 presentation (slides) - Christian

:contribution_christian_presentation a cerif_core:Contribution_to_Document ;
    cerif_core:startDate "2025"^^xsd:gYear ;
    cerif_core:endDate "2025-03-25"^^xsd:date ;
    cerif_core:hasAffiliationStatement :affiliation_christian_tib ;
    cerif_core:hasContributionStatement :contribution_statement_christian_presentation .

:christian_hauschke cerif_core:isActorIn :contribution_christian_presentation .

:contribution_statement_christian_presentation a cerif_core:CRediT_Contribution_Statement ;
    cerif_core:roleType "Writing – original draft" ;
    cerif_core:degreeOfContribution "Lead" ;
    cerif_core:statement = "Christian produces the first 34 slides."@en  .

### Contribution to CRIS 2024 presentation (slides) - Dragan

:contribution_dragan_presentation a cerif_core:Contribution_to_Document ;
    cerif_core:startDate "2025"^^xsd:gYear ;
    cerif_core:endDate "2025-03-25"^^xsd:date ;
    cerif_core:hasAffiliationStatement :affiliation_dragan_lyrasis ;
    cerif_core:hasContributionStatement :contribution_statement_dragan_presentation .

:dragan_ivanovic cerif_core:isActorIn :contribution_dragan_presentation .

:contribution_statement_dragan_presentation a cerif_core:CRediT_Contribution_Statement ;
