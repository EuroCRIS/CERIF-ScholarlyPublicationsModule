### Christian's presentation at ZBMed (Contribution_to_Event)

:contribution_christian_zbmed_march2025 a cerif_core:Contribution_to_Event ;
  cerif_core:Activity:hasActor :christian_hauschke ;
  cerif_core:Contribution_to_Event:hasTarget :zbmed_march2025 ;
  cerif_core:Activity:dateRange [
    a cerif_core:Date_Range ;
    cerif_core:Date_Range:startDate "2025-03-25"^^xsd:date
  ] ;
  cerif_core:Activity:hasAffiliationStatement :affiliation_christian_tib ;
  cerif_core:Contribution:hasContributionStatement :contribution_statement_christian_zbmed_march2025 .

:contribution_statement_christian_zbmed_march2025 a cerif_core:Contribution_Statement ;
  cerif_core:Contribution_Statement:statement "Christian presented VIVO as an ontology, as well as main features of the VIVO platform. His speech generated 7 sections in the complete session."@en ;
  cerif_core:Contribution_Statement:provides :presentation_video_1  ,
            :presentation_video_2 ;
  cerif_core:Contribution_Statement:isDetailedIn :resource_usage_statement_christian_dragan_zbmed_march2025 .

