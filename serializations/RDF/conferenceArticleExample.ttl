:open_access a cerif_spm:Open_Access_COAR_Accessibility_Specification_v1.0 .

:cris_series a cerif_core:Event_Series ;
    cerif_core:title "International Conference on Current Research Information Systems"@en ;
    cerif_core:acronym "CRIS"@en ;
    cerif_core:recurrencePeriod 2 ;
    cerif_core:recurrenceUnit "year"@en .

:cris2024_event a cerif_core:Event ;
    cerif_core:title "16th International Conference on Current Research Information Systems"@en ;
    cerif_core:acronym "CRIS 2024"@en ;
    cerif_core:ordinalNumber 16 ;
    cerif_core:dateRange [
        a cerif_core:DateRange	;
        cerif_core:startDate "2024-05-15"^^xsd:date ;
        cerif_core:endDate "2024-05-17"^^xsd:date ;
    ]
    cerif_core:isPartOf :cris_series .

:cris2024_presentation a cerif_spm:Presentation	,
							cerif_core:Textual_Contents	,
							cerif_core:Downloadable	,
							cerif_core:Accessible_on_the_Web	;
    cerif_core:title "TeslaRIS - Reengineering of CRIS at University of Novi Sad"@en ;
	cerif_core:downloadURL <https://dspacecris.eurocris.org/bitstream/11366/2540/4/Mr%c5%a1ulja-et-al-CRIS2024_slides_Reengineering-of-CRIS-at-UNS.pdf> ;
    cerif_core:accessURL <https://dspacecris.eurocris.org/handle/11366/2540> ;
	cerif_spm:hasAccessRightsSpecification :open_access	;
    cerif_core:publicationDate "2024-05-14"^^xsd:date ;
	cerif_core:isPublishedIn :dspace_cris_eurocris ;
    cerif_core:hasIdentifier :handle_presentation .

:handle_presentation a cerif_core:Handle_Identifier ;
    cerif_core:handle "11366/2540"^^xsd:string .

:cris2024_extended_abstract a cerif_core:Conference_Abstract ,
							cerif_core:Textual_Contents	,
							cerif_core:Downloadable	,
							cerif_core:Accessible_on_the_Web	;
    cerif_core:title "TeslaRIS - Reengineering of CRIS at University of Novi Sad"@en ;
    cerif_core:downloadURL <https://dspacecris.eurocris.org/bitstream/11366/2540/1/Mr%c5%a1ulja-et-al-CRIS2024_Reengineering-of-CRIS-at-UNS.pdf> ;
    cerif_core:accessURL <https://dspacecris.eurocris.org/handle/11366/2540> ;
    cerif_spm:hasAccessRightsSpecification :open_access	;
    cerif_core:publicationDate "2024-03-01"^^xsd:date ;
	cerif_core:isPublishedIn :dspace_cris_eurocris .

:cris2024_full_paper a cerif_core:Conference_Article ,
							cerif_core:Textual_Contents	,
							cerif_core:Accessible_on_the_Web	;
    cerif_core:title "Reengineering of CRIS at University of Novi Sad"@en ;
    cerif_core:accessURL <https://www.sciencedirect.com/science/article/pii/S1877050924032630> ;
	cerif_spm:hasAccessRightsSpecification :open_access	;
    cerif_core:publicationDate "2024"^^xsd:gYear ;
    cerif_core:hasIdentifier :doi_fullpaper ;
    cerif_core:isPartOf cris2024_proceedings .

:doi_fullpaper a cerif_core:DOI_Identifier ;
    cerif_core:DOI_ID "10.1016/j.procs.2024.11.052"^^xsd:string .

:proceedia_computer_science a cerif_core:Books_Series ;
    cerif_core:title "Proceedia Computer Science"@en ;
    cerif_spm:hasISSN "1877-0509"^^xsd:string .

:cris2024_proceedings a cerif_core:Proceedings ,
                             cerif_core:Textual_Contents ,
                             cerif_core:Accessible_on_the_Web ;
    cerif_core:title "Proceedings of 16th International Conference on Current Research Information Systems (CRIS 2024)"@en ;
    cerif_core:accessURL <https://www.sciencedirect.com/journal/procedia-computer-science/vol/249> ;
    cerif_core:publicationDate "2024"^^xsd:gYear ;
    cerif_core:isPublishedIn :proceedia_computer_science ;
    cerif_core:hasEvent :cris2024_event .

[] a rdf:Statement,
	cerif_core:Serial_Publication_Based_Contents_Location;
	rdf:Subject	:cris2024_proceedings	;
	rdf:Predicate cerif_core:isPublishedIn	;
	rdf:Object	:proceedia_computer_science	;
    cerif_core:volume "249"^^xsd:integer .

[] a rdf:Statement,
	cerif_core:Page_Based_Contents_Location;
	rdf:Subject	:cris2024_full_paper	;
	rdf:Predicate cerif_core:isPartOf	;
	rdf:Object	:cris2024_proceedings	;
	cerif_core:startPage "85"^^xsd:integer ;
    cerif_core:endPage "93"^^xsd:integer .


:dspace_cris_eurocris a cerif_core:Repository ;
    cerif_core:title "The euroCRIS repository"@en ;
    cerif_core:url <https://dspacecris.eurocris.org/> .


